# ---------------------------------------------------------------------------
# HSEA 2026 backend — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL
# Standard connection string form. Use SSL in production (append ?sslmode=require
# or set DATABASE_SSL=true depending on your provider).
DATABASE_URL=postgres://hsea_app:changeme@localhost:5432/hsea2026
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Auth
JWT_SECRET=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
COOKIE_SECRET=replace-with-a-different-long-random-value

# CORS — comma-separated list of allowed origins, no trailing slashes
CORS_ORIGIN=https://hsea2026.example.com,https://www.hsea2026.example.com

# Redis (optional but recommended for horizontal scaling — used for
# distributed rate limiting and idempotency locks). If unset, the backend
# falls back to in-memory limiting, which is NOT safe across multiple
# instances and should only be used for local development.
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
